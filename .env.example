# Public Supabase configuration: safe for browser use; protect data with RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only privileged Supabase key; retain for future backend operations.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only Gemini API key; never expose through NEXT_PUBLIC_ variables.
GEMINI_API_KEY=

