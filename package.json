{
  "name": "automated-portfolio-management-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Nexus Solutions portfolio generation platform monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace frontend run dev",
    "build:frontend": "npm --workspace frontend run build",
    "test": "npm --workspace frontend run test --if-present && npm --workspace backend run test --if-present",
    "lint": "npm --workspace frontend run lint",
    "typecheck": "npm --workspace frontend run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:staged": "lint-staged",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10"
  }
}
